# Quellordner mit den Büchern (wird nur gelesen, niemals geschrieben)
BOOKS_DIR=
# Pfad zur SQLite-Datenbank für den Verarbeitungsstand (außerhalb von BOOKS_DIR)
STATE_DB=

# Meilisearch-Verbindung. MEILI_KEY ist der Master-Key oder ein API-Key mit Schreibrechten.
# Master-Key erzeugen: openssl rand -hex 32
MEILI_URL=http://localhost:7700
MEILI_KEY=
MEILI_INDEX=buecher

# OCR-Sprache für tesseract
OCR_LANG=deu
# Schwelle (Zeichen pro Seite im Durchschnitt), ab der eine PDF als textbasiert gilt
MIN_CHARS_PER_PAGE=50
# Maximale Länge einer Passage in Zeichen
MAX_CHUNK_CHARS=1500

# Wartezeit in Sekunden auf eine Meilisearch-Aufgabe.
MEILI_TASK_TIMEOUT=3600

# Embedder (optional): OpenAI-kompatibler Endpunkt, ohne /embeddings am Ende.
# Leer lassen, um ohne Embeddings zu indexieren. buchindex berechnet die
# Vektoren der Passagen; Meilisearch ruft den Endpunkt für Suchanfragen auf.
EMBEDDER_URL=
EMBEDDER_MODEL=
EMBEDDER_DIMENSIONS=
EMBEDDER_API_KEY=
EMBEDDER_NAME=default

# Ressourcen
# Zahl der Prozesse, die gleichzeitig Dateien extrahieren
EXTRACT_JOBS=1
# Zahl der gleichzeitigen Anfragen an den Embedding-Server und Passagen pro Anfrage
EMBED_PARALLEL=1
EMBED_BATCH_SIZE=8
# Zeitgrenze in Sekunden für eine Anfrage an den Embedding-Server
EMBED_TIMEOUT=300
# Zwischenablage für extrahierte Passagen und Vektoren (Standard: <STATE_DB>.work)
WORK_DIR=

# Nur für compose.yaml
# Adressen, die Meilisearch aufrufen darf (Embedding-Server im eigenen Netz),
# z. B. 192.168.178.82/32. Auskommentiert lassen, wenn nichts freizugeben ist.
#MEILI_ALLOWED_IP_NETWORKS=
# Kerne, die Meilisearch beim Indexieren belegt
MEILI_MAX_INDEXING_THREADS=2
# Adresse und Port, unter denen Meilisearch auf dem Server erreichbar ist
MEILI_BIND=127.0.0.1:7700
